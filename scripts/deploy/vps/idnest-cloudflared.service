[Unit]
Description=Idnest Cloudflare Tunnel connector
Documentation=https://developers.cloudflare.com/tunnel/
Wants=network-online.target
After=network-online.target
ConditionFileNotEmpty=/etc/idnest/cloudflared.token

[Service]
Type=notify
DynamicUser=true
LoadCredential=tunnel-token:/etc/idnest/cloudflared.token
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --loglevel info --metrics 127.0.0.1:20242 run --token-file ${CREDENTIALS_DIRECTORY}/tunnel-token
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
