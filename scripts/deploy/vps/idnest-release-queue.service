[Unit]
Description=Process queued Idnest application and identity releases as root
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/process-idnest-release-queue
PrivateTmp=true
UMask=0027
TimeoutStartSec=35min
