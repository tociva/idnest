AUTH_URL=https://auth.idnest.cloud
CORS_ALLOWED_ORIGINS=https://*.idnest.cloud,https://*.daybook.cloud
HYDRA_DSN=postgres://hydrau:replace-with-hydra-password@host.docker.internal:5432/hydra?sslmode=disable
HYDRA_URLS_SELF_ISSUER=https://hydra.idnest.cloud/
HYDRA_URLS_CONSENT=https://auth.idnest.cloud/oauth2/consent
HYDRA_URLS_LOGIN=https://auth.idnest.cloud/oauth2/login
HYDRA_URLS_LOGOUT=https://auth.idnest.cloud/logout
HYDRA_URLS_POST_LOGOUT_REDIRECT=https://admin.idnest.cloud/auth/logout
HYDRA_URLS_ERROR=https://auth.idnest.cloud/error
HYDRA_SECRETS_SYSTEM=replace-with-a-long-random-secret
KRATOS_DSN=postgres://kratosu:replace-with-kratos-password@host.docker.internal:5432/kratos?sslmode=disable
KRATOS_SERVE_PUBLIC_BASE_URL=https://kratos.idnest.cloud
KRATOS_ADMIN_URL=http://localhost:4434
KRATOS_URLS_LOGOUT=https://hydra.idnest.cloud/oauth2/sessions/logout
KRATOS_COOKIES_DOMAIN=.idnest.cloud
KRATOS_LOG_LEVEL=info
KRATOS_CSRF_COOKIE_SECRET=replace-with-a-long-random-secret
KRATOS_CIPHER_SECRET=replace-with-32-character-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY_ID=
APPLE_PRIVATE_KEY=
