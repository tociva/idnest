TLS_SERVER_NAME=auth.idnest.cloud
HYDRA_ADMIN_URL=https://hydra.idnest.cloud:4445
KRATOS_ADMIN_URL=http://idnest-kratos:4434
KRATOS_PUBLIC_URL=https://kratos.idnest.cloud
KRATOS_INTERNAL_URL=https://kratos.idnest.cloud:4433
CORS_ALLOWED_ORIGINS=https://*.idnest.cloud,https://*.daybook.cloud
ADMIN_CORS_ALLOWED_ORIGINS=https://admin.idnest.cloud
AUTHZ_DATABASE_URL=postgres://authzu:replace-with-password@host.docker.internal:5432/authz?sslmode=disable
CONSENT_GATE_MODE=enforce
CONSENT_ACTION_SECRET=replace-with-a-long-random-secret
AUTH_BRANDING_MODE=enforce
AUTH_STRICT_UNMAPPED_CLIENTS=true
AUTH_TRANSACTION_TTL_SECONDS=600
AUTH_TRANSACTION_SECRET=replace-with-a-32-byte-or-longer-random-secret
AUTH_AUDIT_HASH_SECRET=replace-with-an-independent-long-random-secret
AUTH_ASSET_ALLOWED_ORIGINS=https://assets.idnest.cloud
AUTH_LINK_ALLOWED_ORIGINS=https://idnest.cloud,https://daybook.cloud,https://taskme.sh
AUTH_BASE_URL=https://auth.idnest.cloud
ADMIN_PUBLIC_ORIGIN=https://admin.idnest.cloud
ADMIN_BOOTSTRAP_EMAILS=admin@example.com
