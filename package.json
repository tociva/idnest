{
  "name": "idnest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "workspace:install": "pnpm --dir=monorepo install",
    "build": "pnpm --dir=monorepo build",
    "auth-backend:build": "pnpm --dir=monorepo auth-backend:build",
    "auth-frontend:build": "pnpm --dir=monorepo auth-frontend:build",
    "admin-backend:build": "pnpm --dir=monorepo admin-backend:build",
    "admin-frontend:build": "pnpm --dir=monorepo admin-frontend:build",
    "test": "pnpm --dir=monorepo test",
    "lint": "pnpm --dir=monorepo lint",
    "typecheck": "pnpm --dir=monorepo typecheck",
    "auth-backend:serve": "pnpm --dir=monorepo auth-backend:serve",
    "auth-frontend:serve": "pnpm --dir=monorepo auth-frontend:serve",
    "admin-backend:serve": "pnpm --dir=monorepo admin-backend:serve",
    "admin-frontend:serve": "pnpm --dir=monorepo admin-frontend:serve",
    "authz:migrate": "pnpm --dir=monorepo authz:migrate",
    "authz:migrate:build": "pnpm --dir=monorepo authz:migrate:build",
    "db:migrate": "./scripts/deploy/run-migrations.sh",
    "nx": "pnpm --dir=monorepo nx",
    "bootstrap:local": "./scripts/setup/bootstrap-local.sh",
    "clients:cors:backfill": "node scripts/setup/backfill-client-cors.js",
    "test:cors:config": "bash scripts/deploy/test-cors-contract.sh",
    "test:deploy": "bash scripts/ci/test-deployment-contracts.sh",
    "test:apple": "bash scripts/ci/test-apple-login-contracts.sh",
    "test:cors": "pnpm test:cors:config && pnpm test:client-cors:integration",
    "test:cors:live": "bash scripts/deploy/test-hydra-cors-live.sh",
    "test:client-cors:integration": "bash scripts/docker/test-client-cors-integration.sh",
    "test:client-secret:integration": "HYDRA_SECRET_INTEGRATION=1 HYDRA_SECRET_TEST_ADMIN_URL=http://127.0.0.1:4445 HYDRA_SECRET_TEST_PUBLIC_URL=http://127.0.0.1:4444 pnpm --dir=monorepo exec vitest run --root apps/admin-backend --config vitest.config.ts src/app/__tests__/clients-secret-replacement.integration.test.ts --testTimeout=10000 --hookTimeout=10000"
  },
  "packageManager": "pnpm@9.15.0"
}
