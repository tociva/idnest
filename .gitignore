# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules

# testing
coverage

# build output
dist
build

# generated browser runtime configuration
monorepo/apps/admin-frontend/public/config/config.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# typescript
*.tsbuildinfo

# identity runtime
kratos.yml
temp
/tmp/

# terraform working data and local plans/state
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
**/terraform.tfvars
!**/terraform.tfvars.example

# rendered GitHub environment payloads (examples remain tracked)
**/*.vars.env
!**/*.vars.env.example
**/*.secrets.env
!**/*.secrets.env.example
